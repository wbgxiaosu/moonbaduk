name = "wbgxiaosu/moonbaduk"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/wbgxiaosu/moonbaduk"

license = "Apache-2.0"

keywords = [
  "go",
  "baduk",
  "weiqi",
  "sgf",
  "gtp",
  "rules-engine",
]

preferred_target = "wasm-gc"

description = "Go (Weiqi/Baduk) rules engine library for MoonBit: captures, ko & positional superko, area scoring, SGF (FF[4]) parse/write/replay and an embeddable GTP engine / 围棋规则引擎：提子、劫与全局同形禁止、数子法计分、SGF 棋谱与 GTP 引擎"
